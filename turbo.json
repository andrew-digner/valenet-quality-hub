{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "env": [
        "DATABASE_URL",
        "JWT_REFRESH_SECRET",
        "JWT_SECRET",
        "NODE_ENV",
        "POSTGRES_DB",
        "POSTGRES_PASSWORD",
        "POSTGRES_USER"
      ],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
