NODE_ENV=development
APP_NAME=Valenet Quality Hub
APP_VERSION=0.1.0

FRONTEND_PORT=3000
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

POSTGRES_DB=valenet_quality_hub
POSTGRES_USER=valenet
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://valenet:change-me-for-local-development@localhost:5432/valenet_quality_hub?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000
REDIS_HOST=localhost
REDIS_PASSWORD=

LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=not-configured
AI_MAX_REQUESTS=100

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@valenet.com.br

STORAGE_MAX_UPLOAD_MB=25
STORAGE_BUCKET=quality-hub
STORAGE_DIRECTORY=uploads

AI_ENABLED=false
CALIBRATION_ENABLED=false
APPEALS_ENABLED=false
NOTIFICATIONS_ENABLED=false
