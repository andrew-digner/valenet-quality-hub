{
  "name": "valenet-quality-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo do Valenet Quality Hub.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --parallel --filter @valenet/frontend --filter @valenet/backend run dev",
    "dev:frontend": "pnpm --filter @valenet/frontend dev",
    "dev:backend": "pnpm --filter @valenet/backend dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/validate-docs.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:ps": "docker compose ps",
    "prisma:generate": "pnpm --filter @valenet/backend prisma:generate",
    "prisma:validate": "pnpm --filter @valenet/backend prisma:validate",
    "prepare": "node scripts/prepare.mjs",
    "commitlint": "commitlint --from HEAD~1 --to HEAD"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
